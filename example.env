PORT=3000
NODE_ENV=development

DB_HOST=db
DB_USER=rastreador_user
DB_PASSWORD=root
DB_NAME=rastreador_db
DB_PORT=3306
DB_EXTERNAL_PORT=3307

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=rastreador_db
MYSQL_USER=rastreador_user
MYSQL_PASSWORD=root

# Usuario admin automático para docker compose dev (solo backend en NODE_ENV=development)
DEV_ADMIN_NAME=Admin
DEV_ADMIN_EMAIL=admin@rastreador.local
DEV_ADMIN_PASSWORD=admin1234
DEV_ADMIN_PHONE=

# Descomenta la siguiente línea si quieres usar la api en localhost
#EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0